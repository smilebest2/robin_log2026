OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# prewritten uses data/prewritten-posts.jsonl and does not call OpenAI.
# Set POST_SOURCE=ai to generate new posts with OpenAI at runtime.
POST_SOURCE=prewritten

# OAuth 1.0a credentials for posting to X.
# Consumer Key
X_APP_KEY=
# Consumer Secret
X_APP_SECRET=
# Access Token
X_ACCESS_TOKEN=
# Access Token Secret
X_ACCESS_SECRET=

# Alias names are also accepted locally:
# X_CONSUMER_KEY=
# X_CONSUMER_SECRET=
# X_ACCESS_TOKEN_SECRET=

# OAuth 2.0 user access token mode.
# Requires a user access token with tweet.write scope.
# X_AUTH_MODE=oauth2
# X_OAUTH2_ACCESS_TOKEN=
# X_OAUTH2_REFRESH_TOKEN=

# Optional: force a posting slot for manual tests.
# POST_DATE=2026-06-09
# POST_TIME=08:00

# Reply to inbound mentions before each scheduled post.
INBOUND_REPLY_ENABLED=1
INBOUND_REPLY_SLOT=20:00
INBOUND_REPLY_LIMIT=2

# Reply to the newly published post after a random delay.
SELF_REPLY_ENABLED=1
SELF_REPLY_DELAY_MIN_MS=60000
SELF_REPLY_DELAY_MAX_MS=120000

# Optional: generate and log without publishing to X.
# DRY_RUN=1
